---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../i18n/routes';
---

<BaseLayout
  title="404 — Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  locale="es"
  alternates={{}}
  noindex
>
  <section class="relative isolate overflow-hidden">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="glow top-10 left-1/2 -z-10 h-72 w-[30rem] -translate-x-1/2 bg-brand-500/40" aria-hidden="true"></div>
    <div class="container-x flex min-h-[65vh] flex-col items-center justify-center py-24 text-center">
      <p class="font-mono text-7xl font-medium text-gradient sm:text-8xl">404</p>
      <h1 class="mt-6 text-2xl font-semibold text-fg sm:text-3xl">Página no encontrada</h1>
      <p class="mt-3 text-muted" lang="en">Page not found</p>
      <p class="mt-6 max-w-md text-muted">La página que buscas no existe o ha cambiado de dirección.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={routes.home.es} class="btn-primary">Ir al inicio</a>
        <a href={routes.home.en} class="btn-ghost" hreflang="en" lang="en">Go to homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
