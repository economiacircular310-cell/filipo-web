---
import { otherLocale, path, type Alternates, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const target = otherLocale(locale);
// Fall back to the other language's home page when this page has no translation.
const href = alternates[target] ?? path('home', target);
---

<a
  href={href}
  hreflang={target}
  lang={target}
  class="inline-flex h-10 items-center gap-1.5 rounded-full border border-line-strong px-3 font-mono text-xs text-muted transition hover:border-brand-400/60 hover:text-fg"
  title={ui[target]['lang.name']}
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
  </svg>
  <span class="sr-only">{ui[locale]['a11y.langSwitch']}: {ui[target]['lang.name']}</span>
  <span aria-hidden="true">{ui[target]['lang.short']}</span>
</a>
