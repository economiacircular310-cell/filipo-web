---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { getServices } from '../../lib/content';
import { path, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** Hide the section heading when the page already provides one (services hub). */
  showHeading?: boolean;
}

const { locale, showHeading = true } = Astro.props;
const t = useTranslations(locale);
const services = await getServices(locale);

const copy = {
  es: {
    title: 'Tres especialidades, un mismo objetivo: que tu negocio crezca en digital',
    lead: 'Construimos el producto, hacemos que te encuentren y nos aseguramos de que vuele. Puedes contratar cada servicio por separado o combinarlos.',
    combo: 'Mejor juntos',
    comboText:
      'Una web a medida pensada desde el código para el SEO y la velocidad posiciona antes y convierte más que una web optimizada a posteriori.',
  },
  en: {
    eyebrow: '// 01 — Services',
    title: 'Three specialities, one goal: growing your business online',
    lead: "We build the product, make sure people find it and make sure it flies. Hire each service on its own or combine them.",
    combo: 'Better together',
    comboText:
      'A custom website engineered for SEO and speed from the first line of code ranks sooner and converts better than a site optimized after the fact.',
  },
}[locale];

const accents = ['from-brand-500/25', 'from-violet-500/25', 'from-cyan-400/20'];
---

<section class="container-x py-20 sm:py-28" aria-labelledby={showHeading ? 'services-title' : undefined}>
  {showHeading && <SectionHeading id="services-title" eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />}

  <div class:list={['grid gap-5 md:grid-cols-2 lg:grid-cols-3', showHeading && 'mt-14']}>
    {
      services.map((service, i) => (
        <a
          href={service.href}
          class:list={[
            'card card-hover group flex flex-col overflow-hidden p-7',
            i === 0 && 'md:col-span-2',
          ]}
        >
          <div
            class:list={['absolute inset-0 -z-0 bg-gradient-to-br to-transparent opacity-0 transition group-hover:opacity-100', accents[i % 3]]}
            aria-hidden="true"
          />
          <div class="relative flex h-full flex-col">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-line-strong bg-ink-700 text-brand-400">
              <Icon name={service.data.icon} size={22} />
            </span>
            <h3 class:list={['mt-6 font-semibold tracking-tight text-fg', i === 0 ? 'text-2xl sm:text-3xl' : 'text-xl']}>
              {service.data.title}
            </h3>
            <p class="mt-3 leading-relaxed text-muted">{service.data.tagline}</p>
            <ul class:list={['mt-6 grid gap-2.5 text-sm text-muted', i === 0 && 'sm:grid-cols-2']}>
              {service.data.deliverables.slice(0, i === 0 ? 6 : 4).map((d) => (
                <li class="flex gap-2">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-cyan-400" />
                  {d}
                </li>
              ))}
            </ul>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-brand-400">
              {t('cta.learnMore')}
              <span class="sr-only">: {service.data.title}</span>
              <Icon name="arrow" size={16} class="transition group-hover:translate-x-1" />
            </span>
          </div>
        </a>
      ))
    }

    <div class="card flex flex-col justify-between gap-6 bg-gradient-to-br from-brand-500/15 via-ink-800/60 to-violet-500/10 p-7 md:col-span-2 lg:flex-row lg:items-center">
      <div>
        <span class="eyebrow text-cyan-400">{copy.combo}</span>
        <p class="mt-3 max-w-3xl leading-relaxed text-fg">{copy.comboText}</p>
      </div>
      <a href={path('contact', locale)} class="btn-ghost shrink-0 self-start lg:self-center">{t('cta.primary')}</a>
    </div>
  </div>
</section>
