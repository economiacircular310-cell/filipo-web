---
import SectionHeading from '../ui/SectionHeading.astro';
import { stack } from '../../data/stack';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  es: {
    eyebrow: '',
    title: 'Tecnologías modernas, probadas y sin dependencia de proveedor',
    lead: 'Elegimos herramientas con comunidades sólidas y buen soporte a largo plazo, para que tu proyecto sea fácil de mantener.',
  },
  en: {
    eyebrow: '// 04 — Technology',
    title: 'Modern, proven technology with no vendor lock-in',
    lead: 'We choose tools with strong communities and long-term support, so your project stays easy to maintain.',
  },
}[locale];
---

<section class="container-x py-20 sm:py-28" aria-labelledby="stack-title">
  <SectionHeading id="stack-title" eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />
  <dl class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
    {
      stack.map((group) => (
        <div class="card p-6">
          <dt class="font-mono text-xs tracking-wider text-subtle uppercase">{group.group[locale]}</dt>
          <dd class="mt-4">
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md border border-line-strong bg-ink-700/60 px-2.5 py-1 font-mono text-xs text-fg">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
