---
import { site } from '../config/site';
import { getServices } from '../lib/content';
import { abs } from '../lib/schema';
import { path, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = await getServices(locale);

const copy = {
  es: {
    subject: 'Nuevo contacto desde filipostudio.com',
    name: 'Nombre',
    email: 'Email',
    company: 'Empresa',
    optional: 'opcional',
    service: '¿En qué podemos ayudarte?',
    serviceOther: 'Otro / aún no lo sé',
    budget: 'Presupuesto orientativo',
    budgets: ['< 3.000 €', '3.000 – 10.000 €', '10.000 – 30.000 €', '> 30.000 €', 'Aún no lo sé'],
    message: 'Cuéntanos tu proyecto',
    messageHint: 'Objetivos, plazos, enlaces… cuanto más contexto, mejor propuesta.',
    consentPre: 'He leído y acepto la',
    consentLink: 'política de privacidad',
    submit: 'Enviar mensaje',
    sending: 'Enviando…',
    success: '¡Gracias! Hemos recibido tu mensaje y te responderemos en menos de un día laborable.',
    error: 'No hemos podido enviar el mensaje. Inténtalo de nuevo o escríbenos a',
    select: 'Selecciona una opción',
    missingKey: 'Falta PUBLIC_WEB3FORMS_KEY en .env: el formulario no enviará mensajes hasta configurarla.',
  },
  en: {
    subject: 'New enquiry from filipostudio.com',
    name: 'Name',
    email: 'Email',
    company: 'Company',
    optional: 'optional',
    service: 'How can we help?',
    serviceOther: "Other / not sure yet",
    budget: 'Estimated budget',
    budgets: ['< €3,000', '€3,000 – 10,000', '€10,000 – 30,000', '> €30,000', 'Not sure yet'],
    message: 'Tell us about your project',
    messageHint: 'Goals, timeline, links… the more context, the better the proposal.',
    consentPre: 'I have read and accept the',
    consentLink: 'privacy policy',
    submit: 'Send message',
    sending: 'Sending…',
    success: "Thank you! We've received your message and will reply within one business day.",
    error: "We couldn't send your message. Please try again or email us at",
    select: 'Select an option',
    missingKey: 'PUBLIC_WEB3FORMS_KEY is missing in .env: the form will not send messages until it is set.',
  },
}[locale];

const input =
  'mt-2 block w-full rounded-xl border border-line-strong bg-ink-950/60 px-4 py-3 text-fg placeholder:text-subtle transition focus:border-brand-400 focus:ring-2 focus:ring-brand-500/30 focus:outline-none';
const label = 'block text-sm font-medium text-fg';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="card space-y-6 p-6 sm:p-8"
  data-contact-form
  data-sending={copy.sending}
  data-success={copy.success}
  data-error={copy.error}
>
  {
    import.meta.env.DEV && !site.web3formsKey && (
      <p class="rounded-lg border border-danger/40 bg-danger/10 p-3 text-sm text-danger">{copy.missingKey}</p>
    )
  }
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value={copy.subject} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={abs(path('contactThanks', locale))} />
  <!-- Honeypot: bots fill it, humans never see it -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>{copy.name}</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="120" class={input} />
    </div>
    <div>
      <label for="cf-email" class={label}>{copy.email}</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="160" class={input} />
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-company" class={label}>{copy.company} <span class="font-normal text-subtle">({copy.optional})</span></label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120" class={input} />
    </div>
    <div>
      <label for="cf-budget" class={label}>{copy.budget} <span class="font-normal text-subtle">({copy.optional})</span></label>
      <select id="cf-budget" name="budget" class={input}>
        <option value="">{copy.select}</option>
        {copy.budgets.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>
  </div>

  <fieldset>
    <legend class={label}>{copy.service}</legend>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        [...services.map((s) => s.data.title), copy.serviceOther].map((option, i) => (
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line-strong bg-ink-950/40 px-4 py-3 text-sm text-muted transition hover:border-brand-400/60 has-[:checked]:border-brand-400 has-[:checked]:bg-brand-500/10 has-[:checked]:text-fg">
            <input type="radio" name="service" value={option} required={i === 0} class="h-4 w-4 accent-brand-500" />
            {option}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div>
    <label for="cf-message" class={label}>{copy.message}</label>
    <p id="cf-message-hint" class="mt-1 text-sm text-subtle">{copy.messageHint}</p>
    <textarea id="cf-message" name="message" rows="6" required minlength="10" maxlength="5000" aria-describedby="cf-message-hint" class={input}
    ></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm text-muted">
    <input type="checkbox" name="privacy_consent" value="yes" required class="mt-0.5 h-4 w-4 accent-brand-500" />
    <span>
      {copy.consentPre}{' '}
      <a href={path('privacy', locale)} class="text-brand-400 underline underline-offset-4">{copy.consentLink}</a>.
    </span>
  </label>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button type="submit" class="btn-primary px-7 py-3 text-base disabled:cursor-wait disabled:opacity-70" data-submit>
      {copy.submit}
    </button>
    <p role="status" aria-live="polite" class="text-sm" data-status></p>
  </div>
</form>

<script is:inline define:vars={{ email: site.email }}>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    const button = form.querySelector('[data-submit]');
    const status = form.querySelector('[data-status]');
    const label = button.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      button.disabled = true;
      button.textContent = form.dataset.sending;
      status.textContent = '';
      status.className = 'text-sm';

      try {
        const data = Object.fromEntries(new FormData(form));
        delete data.redirect;
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || response.statusText);

        form.reset();
        status.textContent = form.dataset.success;
        status.className = 'text-sm text-success';
      } catch (error) {
        console.error('Contact form error:', error);
        status.textContent = `${form.dataset.error} ${email}`;
        status.className = 'text-sm text-danger';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
