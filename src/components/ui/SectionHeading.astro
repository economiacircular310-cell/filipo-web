---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', id } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="mt-3 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">{title}</Tag>
  {lead && <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{lead}</p>}
</div>
