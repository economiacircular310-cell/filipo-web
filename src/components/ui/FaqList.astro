---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-[var(--radius-card)] border border-line bg-ink-800/40">
  {
    items.map((item) => (
      <details class="group px-5 sm:px-6 [&[open]]:bg-white/[0.015]">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-base font-medium text-fg [&::-webkit-details-marker]:hidden">
          <h3 class="text-pretty">{item.q}</h3>
          <span
            class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-line-strong text-muted transition group-open:rotate-45 group-open:border-brand-400 group-open:text-brand-400"
            aria-hidden="true"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M6 1v10M1 6h10" />
            </svg>
          </span>
        </summary>
        <p class="pb-6 leading-relaxed text-pretty text-muted">{item.a}</p>
      </details>
    ))
  }
</div>
