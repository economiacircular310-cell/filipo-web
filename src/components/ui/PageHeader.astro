---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs: Crumb[];
}

const { locale, eyebrow, title, lead, breadcrumbs } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-line">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow -top-40 left-1/2 -z-10 h-80 w-[40rem] -translate-x-1/2 bg-brand-500/40" aria-hidden="true"></div>
  <div class="container-x pt-10 pb-16 sm:pt-12 sm:pb-20">
    <Breadcrumbs locale={locale} items={breadcrumbs} />
    <div class="mt-10 max-w-3xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance text-fg sm:text-5xl">{title}</h1>
      {lead && <p class="mt-5 text-lg leading-relaxed text-pretty text-muted sm:text-xl">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
