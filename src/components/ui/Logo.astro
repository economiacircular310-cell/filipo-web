---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop stop-color="#6366F1"></stop>
        <stop offset="1" stop-color="#8B5CF6"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="8" fill="url(#logo-g)"></rect>
    <path d="M10 8h13v4h-9v2.5h7v4h-7V24h-4z" fill="#fff"></path>
    <rect x="19.5" y="20" width="4" height="4" rx="1" fill="#22D3EE"></rect>
  </svg>
  <span class="text-[1.05rem] font-semibold tracking-tight text-fg">
    filipo<span class="font-mono font-normal text-muted">/studio</span>
  </span>
</span>
