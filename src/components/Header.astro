---
import Logo from './ui/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { path, type Alternates, type Locale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const current = Astro.url.pathname;

const links = [
  { href: path('services', locale), label: t('nav.services') },
  { href: path('process', locale), label: t('nav.process') },
  { href: path('about', locale), label: t('nav.about') },
  { href: path('blog', locale), label: t('nav.blog') },
  { href: path('faq', locale), label: t('nav.faq') },
];
const isActive = (href: string) => current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-ink-900/75 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href={path('home', locale)} class="rounded-md" aria-label="Filipo Studio">
      <Logo />
    </a>

    <nav aria-label={t('a11y.mainNav')} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3.5 py-2 text-sm transition',
                  isActive(link.href) ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <a href={path('contact', locale)} class="btn-primary hidden sm:inline-flex">{t('nav.contact')}</a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line-strong text-fg lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={t('a11y.menu')}
        data-label-open={t('a11y.menu')}
        data-label-close={t('a11y.closeMenu')}
        data-menu-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" data-icon-open></path>
          <path d="M6 6l12 12M18 6L6 18" data-icon-close class="hidden"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('a11y.mainNav')} class="hidden border-t border-line bg-ink-900 lg:hidden" data-menu>
    <ul class="container-x flex flex-col gap-1 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-3 text-base text-fg hover:bg-white/5"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href={path('contact', locale)} class="btn-primary w-full">{t('cta.primary')}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
